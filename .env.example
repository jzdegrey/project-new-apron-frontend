# Copy this file to .env and fill in real values. .env is gitignored.

# Which environment this app is running in. Must be one of: local, stg, prod
APP_ENV=local

# Base URL the frontend uses to reach the backend API
API_BASE_URL=http://localhost:8000

# Secret used to sign/encrypt server-side session data. Use a real, random
# value outside of local dev.
SESSION_SECRET=change-me

# Minimum log level emitted by the logger: debug | info | warn | error
LOG_LEVEL=info
